<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css"  rel="stylesheet">
    <!-- <link rel="stylesheet" href="../public/style.css"> -->
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="#"><i class="fa-brands fa-napster"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/">Главная</a>
        </li>
        {% for type in types %}
        <li class="nav-item">
          <a class="nav-link" href="/?type={{ type.type_name }}"><img src="{{ type.type_image }}" alt="{{ type.type_name }}" style="width: 20px; margin-right: 5px;">{{type.type_name}}</a>
        </li>
        {% endfor %}
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/search">Поиск</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/album-object/create">Добавить альбом</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/add-object-type">Добавить тип альбома</a>
        </li>
      </ul>
      <form action="/set-welcome/">
        <input type="text" name="message" class="form-control mr-2 ml-2">
      </form>
    </div>
    <form action="/logout" method="POST" style="margin-right: 50px;">
        <button class="btn btn-primary">Выход</button>
      </form>
  </div>
</nav>
<div class="container" style="display: grid; grid-template-columns: 3fr 1fr;">
  <div class="mt-3 container">
    {% block content %}
    {% endblock %}
  </div>
  <div class="mt-3 container">
    <p>Последние страницы, которые вы посетили</p>
    {% for page in pages %}
    <div class='page mt-2 mb-2' style="
    border-radius: 7px;
    width: 300px;
    min-height: 40px;
    padding: 15px;
    background-color: #E0EAFF;
    overflow-wrap: break-word;
    ">
      <a href="{{page}}">{{page}}</a><br>
    </div>
    {% endfor %}
  </div>
</div>
</body>
</html>