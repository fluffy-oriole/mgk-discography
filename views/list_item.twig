{% import "forms.twig" as forms %}
<div class="list-group-item col position-relative" style="border: 1px solid rgb(200, 200, 200); padding: 15px; border-radius: 10px; margin-right: 30px;">
    <div class="position-absolute" style="right: 4px; top: 4px;">
        <form action="album/{{album.id}}/delete" method="POST">
            <button type="submit" class="btn btn-danger"><i class="fas fa-times"></i></button>
        </form>
        <a href="album/{{album.id}}/edit" class="btn btn-warning"><i class="fa-regular fa-pen-to-square"></i></a>
    </div>

    
    <img src="{{ album.image }}" style="width: 200px; padding: 5px; border: 1px solid rgb(200, 200, 200); border-radius: 10px;">
    <div style="margin-top: 10px;">{{ forms.btn(album.name, "/album/#{album.id}", true) }}</div>
    {{ forms.btn('Картинка', "/album/#{album.id}/?show=image", false) }}
    {{ forms.btn('Описание', "/album/#{album.id}/?show=info", false) }}
</div>