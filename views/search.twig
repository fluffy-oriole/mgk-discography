{% extends "__layout.twig" %}
{% import "forms.twig" as forms %}

{% block content %}
<h1>Поиск</h1>
<form action="">
    <div class="row g-3 align-items-end">
        <div class="col">
            <label for="selectType" class="form-label">Тип</label>
            <select name="type" class="form-control">
                <option value="">Все</option>
                {% for type in types %}
                    <option value="{{type.id}}" {% if search_type == type.id %}selected{% endif %}>{{type.type_name}}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col">
            <label for="name" class="form-label">Имя</label>
            <input type="text" class="form-control" name="name" value="{{ search_name }}">
        </div>
        <div class="col">
            <label for="name" class="form-label">Описание</label>
            <input type="text" class="form-control" name="description" value="{{ search_description }}">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Найти</button>
        </div>
    </div>
</form>

<table class="mt-3" style="border: 1px solid rgb(200, 200, 200); width: 100%;">
    <tbody>
        {% for album in objects %}
            <tr style="border: 1px solid rgb(200, 200, 200);">
                <td>
                    {{ forms.btn(album.name, "/album/#{album.id}", false) }}
                </td>
            </tr>
        {% endfor %} 
    </tbody>
</table>


{% endblock %}