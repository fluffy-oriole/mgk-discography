{% extends "__layout.twig" %}

{% block content %}
    <h1>Изменение объекта музыкального альбома</h1>
    <hr>
    {% if message %}
        <div class="alert alert-info">
            {{ message }}
            <a href="/album/{{album.id}}">Открыть альбом</a>
        </div>
    {% endif %}

    <form action="" enctype="multipart/form-data" method="POST" class="row g-3">
        <div class="col-4">
            <label class="form-label">Название</label>
            <input type="text" class="form-control" name="title" value="{{album.name}}">
        </div>
        <div class="col-4">
            <label class="form-label">Краткое описание</label>
            <input type="text" class="form-control" name="description" value="{{album.description}}">
        </div>
        <div class="col-4">
            <label class="form-label">Тип</label>
            <select class="form-control" name="type">
                {% for type in types %}
                    <option value="{{type.name}}" {% if type.name == album.type %}selected{% endif %}>
                        {{type.name}}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12">
            <textarea name="info" placeholder="Полное описание..." class="form-control" rows="5">{{album.info}}</textarea>
        </div>
        <div class="mb-3">
            <label for="formFile" class="form-label">Default file input example</label>
            <input class="form-control" type="file" id="formFile" name="image"">
        </div>
        <div class="col-12 text-end">
            <button type="submit" class="btn btn-primary">Изменить</button>
        </div>
    </form>

{% endblock %}